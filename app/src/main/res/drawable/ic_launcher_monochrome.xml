<?xml version="1.0" encoding="utf-8"?>
<!--
  单色图层（Android 13+ 主题化图标）。

  系统会把整层按用户壁纸/主题染成单一颜色，因此这里只需一个纯剪影：
  填充色会被忽略，但为了保证本机预览工具与 Android 渲染一致，仍写成 #FFFFFF。
  形状必须与 ic_launcher_foreground.xml 的盾牌完全一致，否则主题化前后图标会变形。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,16L88,27L88,52Q88,80 54,94Q20,80 20,52L20,27Z" />
</vector>
